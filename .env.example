# Targets the dev DB published by compose.dev.yml on 127.0.0.1:55432
DATABASE_URL=postgresql://lens:lens@127.0.0.1:55432/folioprism

# Optional AI chat keys (server-side only)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# off (default) uses only the first configured provider; on falls back to OpenRouter when Groq fails
CHAT_FALLBACK=off

# Optional keys for scripts/refresh-funds.sh
OPENFIGI_API_KEY=
SEC_USER_AGENT=

# Optional extra copy destination for scripts/personal-backup.sh (outside the repo)
BACKUP_DIR=
